{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tri-shail",
  "account_id": "2cbdfc4d39578d33459c0b114cd310a8",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tri-shail-enquiries",
      "database_id": "0f7e2997-2762-4863-a658-5f4333770c3c",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
}
